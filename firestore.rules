rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // FR6.1: only verified @siswa.um.edu.my accounts.
    function isUM() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@siswa\\.um\\.edu\\.my');
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isModerator() {
      return isUM() && userRole() in ['moderator', 'admin'];
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if isUM() && request.auth.uid == uid
                    && request.resource.data.role == 'student';
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
    }

    match /reports/{reportId} {
      allow read: if isUM();
      allow create: if isUM()
                    && request.resource.data.reporterUid == request.auth.uid
                    && request.resource.data.status == 'unverified'
                    && request.resource.data.get('verifiedBy', null) == null
                    && request.resource.data.get('confirmations', 0) == 0;
      allow update, delete: if isModerator();
    }

    match /quizAttempts/{id} {
      allow create: if isUM() && request.resource.data.uid == request.auth.uid;
      allow read: if isUM() && resource.data.uid == request.auth.uid;
    }

    match /{coll}/{id} {
      // Written only by the backend (Admin SDK). Names follow docs/data-models.md.
      allow read: if isUM() && coll in ['hazardReadings', 'sourceStatus', 'forecasts', 'alerts', 'guidance'];
      allow write: if false;
    }
  }
}
